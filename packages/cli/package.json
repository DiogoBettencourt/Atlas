{
  "name": "@diogobettencourt/atlas-cli",
  "version": "0.1.0",
  "description": "Terminal client for the Atlas agent - a thin, streaming REPL over Atlas's /chat/stream REST API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiogoBettencourt/Atlas.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/DiogoBettencourt/Atlas/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/DiogoBettencourt/Atlas/issues"
  },
  "type": "module",
  "bin": {
    "atlas": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "atlas",
    "cli",
    "agent"
  ],
  "author": "",
  "license": "ISC"
}
